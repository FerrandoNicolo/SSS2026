FROM python

RUN apt-get update && apt-get install -y --no-install-recommends git   && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/mmenapace/SomeBankingApp /app

WORKDIR /app/backend

RUN printf "\nfastapi\n" >> requirements.txt

RUN sed -i 's|allow_origins=\["http://localhost:4200"\]|allow_origins=["*"]|g' main.py

RUN pip install -r requirements.txt

ENTRYPOINT ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "80"]

##Prendo un'immagine di base di python per servire il mio backend.
##Successivamente procedo ad installare git e a clonare la repository
##nella quale ho presente il backend.
##Al contrario di quanto fatto con il dockerfile per il BE precedente, non 
##procedo a copiare i requirements.txt e main.py siccome accedo direttamente alla
##cartella in cui ho copiato la repo.
##Tuttavia, eseguendo semplicemente un 'clone' della repo, dobbiamo andare ad inserire 
##anche 'fastapi' all'interno del file contenente i REQUIREMENTS, altrimenti i mio container non
##funziona.
##A questo punto mi basta intallare i requisiti per poi lanciare il backend.

##NOTA --> Utilizzo di AI per la riga 3, ossia per i comandi di installazione di git. Inoltre è stata
##utilizzata anche per modificare il valore di 'allow_origins' per permettere che il frontend,
##mappato su porta 80, possa comunicare con il backend.
