# Versione corretta del Dockerfile per il frontend per applicazione SomeBankingFrontend

#Fase 1: Build stage
FROM node AS build      
WORKDIR /app
COPY . .
RUN npm i 
RUN ./node_modules/.bin/ng build 

#Fase 2: Runtime stage
FROM nginx:alpine
COPY --from=build /app/dist/SomeBankingFrontend/browser /usr/share/nginx/html